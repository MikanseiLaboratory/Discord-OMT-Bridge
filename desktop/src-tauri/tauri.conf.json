{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord OMT Bridge",
  "version": "0.1.0",
  "identifier": "lab.mikansei.discord-omt-bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Discord OMT Bridge",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://cdn.discordapp.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
